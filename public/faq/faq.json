  "conversation_flows": {

    "DELIVERY_TODAY": {
      "trigger_examples": [
        "Apakah bisa kirim hari ini?",
        "Bisa kirim hari ini?",
        "Cak bisa dianter saiki?",
        "Rek bisa kirim sekarang?",
        "Sam iso antar saiki?"
      ],

      "extracted_entities": {
        "date": "today"
      },

      "missing_entities": [
        "address"
      ],

      "bot_response": "Bisa 😊 Alamat pengiriman lengkapnya di mana?",

      "next_expected_input": "address"
    },

    "DELIVERY_FOLLOWUP": {
      "context": "DELIVERY_TODAY",

      "customer_examples": [
        "Jl. Soekarno Hatta Malang",
        "Malang Kota",
        "Jl. Ijen No 10",
        "rumah saya di Lowokwaru"
      ],

      "action": "save_address",

      "next_question": "product"
    },

    "SHELF_LIFE": {
      "trigger_examples": [
        "Kue nya tahan berapa lama?",
        "Kuenya tahan berapa hari?",
        "Sam kue iki tahan piro?"
      ],

      "intent": "PRODUCT_SHELF_LIFE",

      "next_context": {
        "ask_date_if_needed": true
      }
    },

    "ORDER_FLOW": {
      "steps": [
        {
          "slot": "product",
          "question": "Mau pesan kue yang varian apa?"
        },
        {
          "slot": "quantity",
          "question": "Mau pesan berapa pcs?"
        },
        {
          "slot": "date",
          "question": "Untuk tanggal berapa?"
        },
        {
          "slot": "delivery_or_pickup",
          "question": "Mau dikirim atau ambil langsung?"
        },
        {
          "slot": "address",
          "condition": "delivery_or_pickup == delivery",
          "question": "Boleh kirim alamat lengkapnya?"
        },
        {
          "slot": "payment_method",
          "question": "Pembayarannya mau menggunakan metode apa?"
        },
        {
          "slot": "confirmation",
          "question": "Pesanannya sudah sesuai. Mau kami proses?"
        }
      ]
    }
  },

  "context_management": {

    "context_fields": [
      "active_intent",
      "previous_intent",
      "product",
      "quantity",
      "date",
      "time",
      "address",
      "delivery_or_pickup",
      "payment_method",
      "order_id",
      "customer_name",
      "phone_number",
      "occasion"
    ],

    "rules": [
      {
        "rule": "If customer answers a missing entity, attach it to active intent"
      },
      {
        "rule": "If customer says 'yang tadi', use previous product context"
      },
      {
        "rule": "If customer says 'besok', update date without asking what date"
      },
      {
        "rule": "If customer says 'iya', continue previous flow"
      },
      {
        "rule": "If customer changes topic, switch active intent"
      },
      {
        "rule": "If customer asks multiple questions, process multiple intents"
      },
      {
        "rule": "Never ask for an entity that already exists in context"
      },
      {
        "rule": "Use conversation history to resolve pronouns such as 'ini', 'itu', 'yang tadi', 'yang ini'"
      }
    ]
  },

