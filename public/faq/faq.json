{
  "version": "2.0.0",
  "name": "Kue Pandan Asli Conversational FAQ & Intent Dataset",
  "website": "kuepandanasli.com",
  "language": "id-ID",
  "regions": [
    "Surabaya",
    "Malang",
    "Sidoarjo",
    "Gresik",
    "Batu",
    "Pasuruan",
    "Jawa Timur"
  ],

  "capabilities": {
    "keyword_matching": true,
    "semantic_matching": true,
    "typo_tolerance": true,
    "slang_detection": true,
    "javanese_detection": true,
    "suroboyoan_detection": true,
    "malangan_detection": true,
    "walikan_detection": true,
    "entity_extraction": true,
    "context_awareness": true,
    "conversation_memory": true,
    "slot_filling": true,
    "follow_up_question": true,
    "multi_intent": true,
    "intent_switching": true,
    "order_context": true,
    "customer_context": true,
    "date_parsing": true,
    "time_parsing": true,
    "address_parsing": true,
    "quantity_parsing": true,
    "fallback": true,
    "human_handoff": true
  },

  "conversation_rules": {
    "never_repeat_already_known_entities": true,
    "ask_only_missing_required_entities": true,
    "preserve_previous_context": true,
    "allow_customer_to_change_topic": true,
    "allow_multiple_intents_in_one_message": true,
    "allow_short_answers": true,
    "allow_typo_messages": true,
    "allow_mixed_language": true,
    "allow_incomplete_messages": true,
    "allow_follow_up_without_repeating_subject": true,

    "example": {
      "customer_1": "Apakah bisa kirim hari ini?",
      "bot_1": "Bisa 😊 Alamat pengiriman lengkapnya di mana?",
      "customer_2": "Jl. Soekarno Hatta Malang",
      "bot_2": "Siap. Untuk pengiriman hari ini ke Jl. Soekarno Hatta, Malang. Kuenya mau varian apa dan berapa pcs?"
    }
  },

